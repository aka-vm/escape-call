# Copy to `.env` and fill in. NEVER commit the real .env (it's gitignored).

# --- Twilio (required) ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_FROM_NUMBER="+1XXXXXXXXXX"        # your Twilio number (the caller)

# --- Who to call (pick ONE style) ---
# Labelled list:
ESCAPE_NUMBERS="Me:+91XXXXXXXXXX,Work:+1XXXXXXXXXX"
# …or simple numbered:
# MY_PHONE_NUMBER="+91XXXXXXXXXX"
# MY_PHONE_NUMBER_2="+91XXXXXXXXXX"

# --- Optional ---
ESCAPE_VOICE="Polly.Aditi"   # Twilio <Say> voice (Polly.Aditi = Indian English)
PORT="8500"
