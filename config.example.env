# Copy to `.env` and fill in. NEVER commit the real .env (it's gitignored).

# --- Twilio (required) ---
TWILIO_ACCOUNT_SID="ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
TWILIO_AUTH_TOKEN="your_auth_token"
TWILIO_FROM_NUMBER="+1XXXXXXXXXX"        # your Twilio number (the caller)

# --- Who to call (comma-separated E.164 numbers) ---
ESCAPE_NUMBERS="+91XXXXXXXXXX,+91XXXXXXXXXX"

# --- Optional ---
ESCAPE_VOICE="Polly.Aditi"   # Twilio <Say> voice (Polly.Aditi = Indian English)
# ESCAPE_TO="+91XXXXXXXXXX"    # CLI default destination (--to overrides)
PORT="8500"
